{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"], ["do", "end"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" }, { "open": "[", "close": "]" }, { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }, { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["`", "`"]],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\b(do|else)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(end|else|elif|catch)\\b"
  },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*"
}
