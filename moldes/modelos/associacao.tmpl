    <select name="status"><option>Aberta</option><option>Informada</option><option>Paga</option><option>Isenta</option></select>
  </label>
  <label>Pago em <input type="date" name="pago_em"></label>
</conteudo>

<conteudo nome="avisos" titulo="Avisos" item="aviso">
  <label>Título <input name="titulo" required maxlength="160"></label>
  <label>Categoria <select name="categoria"><option>Avisos</option><option>Assembleias</option><option>Transparência</option><option>Eventos</option><option>Conquistas</option></select></label>
  <label>Texto <textarea name="corpo" data-editor required maxlength="60000"></textarea></label>
  <label>Foto <input type="file" name="capa" accept="image/*" data-max-mb="6" data-publico></label>
</conteudo>

<conteudo nome="assembleias" titulo="Assembleias" item="assembleia">
  <label>Título <input name="titulo" required maxlength="140"></label>
  <label>Data e hora <input type="datetime-local" name="data" required></label>
  <label>Local <input name="local" maxlength="160"></label>
  <label>Pauta <textarea name="pauta" rows="5" maxlength="6000"></textarea></label>
  <label>Ata (depois da assembleia) <textarea name="ata" data-editor maxlength="60000"></textarea></label>
