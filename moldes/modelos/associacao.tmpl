            <div class="form-floating mb-3"><input class="form-control" id="a-nome" name="nome" required maxlength="120" placeholder="Nome completo"><label for="a-nome">Nome completo</label></div>
            <div class="form-floating mb-3"><input class="form-control" id="a-email" name="email" type="email" required maxlength="120" placeholder="nome@exemplo.com"><label for="a-email">E-mail</label></div>
            <div class="form-floating mb-3"><input class="form-control" id="a-fone" name="telefone" type="tel" maxlength="30" placeholder="(00) 00000-0000"><label for="a-fone">Telefone ou WhatsApp</label></div>
            <div class="form-check mb-4"><input class="form-check-input" type="checkbox" id="a-ok" name="aceite" required><label class="form-check-label" for="a-ok">Li e aceito o estatuto e autorizo o uso dos meus dados só para a gestão da associação (LGPD).</label></div>
            <button class="btn btn-primary btn-lg w-100" type="submit">Enviar minha ficha</button>
          </form>
        </div></div>
      </div>
    </div></section>
  </page>

  <!-- ================= Área do sócio ================= -->
  <page route="/socio/:codigo" title="Área do sócio" noindex>
    <nep>
      let s = socio_por_codigo(params.codigo)
      if not s do not_found() end
      gerar_mensalidades(s)
      let ms = mensalidades_de(s)
      let abertas = ms |> filter(fn(m) do m.status == "Aberta" end)
      let verificar = default(request.site, "") + "/verificar/" + s.codigo
    </nep>
    <section class="py-5"><div class="container px-4 px-lg-5">
      <if test="request.query.novo"><div class="nep-ok">Ficha recebida! <b>Guarde este link</b>: é a sua área de sócio. Quando a diretoria aprovar, a carteirinha e o Pix aparecem aqui.</div></if>
      <if test="request.query.informado"><div class="nep-ok">Obrigado! A tesouraria vai conferir o Pix e dar baixa.</div></if>
      <div class="row gx-5">
        <div class="col-lg-5 mb-5">
          <h1 class="fw-bolder h2 mb-1">Olá, {{ first(split(s.nome, ' ')) }}!</h1>
          <p class="text-muted">Situação: <span class="selo {{ s.status }}">{{ s.status }}</span></p>
          <div class="carteirinha mt-4">
            <div class="rotulo">⟦h .Nome⟧</div>
            <div class="rotulo mt-3">Sócio</div>
            <div class="nome">{{ s.nome }}</div>
            <div class="mt-3 small">Nº {{ default(s.numero, s.id) }} · desde {{ ler_data(default(s.desde, '') + ' 00:00').txt }}</div>
            <div class="small mt-1"><b>{{ upper(s.status) }}</b></div>
            <div class="qr">{{ qrcode(verificar) }}</div>
          </div>
          <p class="small text-muted mt-3">O QR Code abre a página de verificação: quem ler vê se a carteirinha é válida.</p>
        </div>
        <div class="col-lg-7 min-w-0">
          <h2 class="fw-bolder h4 mb-3">Mensalidades</h2>
          <if test="s.status == 'Pendente'"><p class="text-muted">Sua ficha está em análise. As mensalidades começam depois da aprovação.</p></if>
          <each m in="ms">
            <div class="card border-0 shadow-sm mb-3"><div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div><b>{{ nome_mes(m.referencia) }}</b><div class="text-muted small">Vence em {{ ler_data(default(m.vencimento, '') + ' 00:00').txt }}</div></div>
                <div class="text-end"><div class="fw-bold">{{ money(float(default(m.valor, MENSALIDADE))) }}</div><span class="selo {{ m.status }}">{{ m.status }}</span></div>
              </div>
              <if test="m.status == 'Aberta'">
                <if test="CHAVE_PIX != ''">
                  <details class="pix mt-3"{{ (m.id == first(abertas).id and ' open') or '' }}>
                    <summary>⟦icone "lightning"⟧ Pagar com Pix</summary>
                    <div class="d-flex gap-4 flex-wrap mt-3 align-items-start">
                      <div class="pix-qr">{{ qrcode(pix_de(m)) }}</div>
                      <div class="min-w-0 flex-grow-1" style="flex-basis:14rem">
                        <div class="small fw-bold mb-1">Pix copia e cola</div>
                        <div class="copia mb-2">{{ pix_de(m) }}</div>
                        <button class="btn btn-sm btn-outline-primary mb-3" type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent.trim());this.textContent='Copiado!'">Copiar código</button>
                        <form save="pagamentos_informados" run="informar" limit="10">
                          <input type="hidden" name="codigo" value="{{ s.codigo }}"><input type="hidden" name="mensalidade" value="{{ m.id }}">
                          <button class="btn btn-primary" type="submit">Já paguei</button>
                        </form>
                      </div>
                    </div>
                  </details>
                <else>
                  <p class="small text-muted mt-3 mb-0">Combine o pagamento com a tesouraria pelo <a href="{{ url('/contato') }}">contato</a>.</p>
                </if>
              </if>
            </div></div>
          </each>
        </div>
      </div>
    </div></section>
  </page>

  <page route="/verificar/:codigo" title="Verificar carteirinha" noindex>
    <nep>let s = socio_por_codigo(params.codigo)</nep>
    <section class="py-5"><div class="container px-4 px-lg-5 my-4 text-center">
      <if test="s and s.status == 'Ativo'">
        <div class="display-1 text-success">⟦icone "shield-check"⟧</div>
        <h1 class="fw-bolder">Carteirinha válida</h1>
        <p class="lead">{{ first(split(s.nome, ' ')) }} é sócio(a) ativo(a) da ⟦h .Nome⟧ (nº {{ default(s.numero, s.id) }}).</p>
      <else>
        <h1 class="fw-bolder">Carteirinha não está ativa</h1>
        <p class="lead text-muted">Este código não corresponde a um sócio ativo. Em caso de dúvida, fale com a diretoria.</p>
      </if>
      <p class="small text-muted">Consultado em {{ ler_data(agora).txt }}, às {{ ler_data(agora).hora }}.</p>
    </div></section>
  </page>

  <page route="/entrar" title="Já sou sócio">
    <section class="py-5"><div class="container px-4 px-lg-5 my-4"><div class="row justify-content-center"><div class="col-lg-6">
      <h1 class="fw-bolder">Já sou sócio</h1>
      <p class="lead text-muted">Digite o e-mail da sua ficha. Se ele estiver cadastrado, mandamos o link da sua área (carteirinha e mensalidades).</p>
      <form save="pedidos_de_link" run="enviar_link" limit="3" success="Se o e-mail estiver cadastrado, o link chega em instantes. Confira também o spam.">
        <div class="input-group input-group-lg"><input class="form-control" name="email" type="email" required placeholder="seu@email.com" aria-label="E-mail"><button class="btn btn-primary" type="submit">Enviar link</button></div>
      </form>
    </div></div></div></section>
  </page>

  <!-- ================= Assembleias ================= -->
  <page route="/assembleias" title="Assembleias">
    <section class="py-5"><div class="container px-4 px-lg-5 my-3">
      <h1 class="fw-bolder mb-4">Assembleias</h1>
      <h2 class="h5 fw-bold text-muted mb-3">Próximas</h2>
      <each a in="proximas">
        <a class="card border-0 shadow-sm mb-3 text-decoration-none link-dark" href="{{ url('/assembleias/' + a.slug) }}"><div class="card-body p-4 d-flex gap-4 align-items-start">
          <div class="data-box"><b>{{ a.quando.dia }}</b><small>{{ a.quando.m3 }}</small></div>
          <div class="min-w-0"><h3 class="h5 fw-bolder mb-1">{{ a.titulo }}</h3><div class="text-muted">{{ a.quando.hora }} · {{ default(a.local, '') }}</div></div>
        </div></a>
      <else><p class="text-muted">Nenhuma marcada.</p></each>
      <h2 class="h5 fw-bold text-muted mt-5 mb-3">Anteriores e atas</h2>
      <ul class="list-unstyled">
        <each a in="anteriores"><li class="mb-2"><a href="{{ url('/assembleias/' + a.slug) }}">{{ a.titulo }}</a> <span class="text-muted small">· {{ a.quando.txt }}<if test="a.ata"> · ata disponível</if></span></li></each>
      </ul>
    </div></section>
  </page>

  <page route="/assembleias/:slug" conteudo="assembleias">
    <nep>
      let a = preparar_assembleia(item)
      let confirmados = len(db.where("presencas", "assembleia", a.slug))
    </nep>
    <section class="py-5"><div class="container px-4 px-lg-5 my-3"><div class="row justify-content-center"><div class="col-lg-8">
      <a class="small text-decoration-none" href="{{ url('/assembleias') }}">← Assembleias</a>
      <h1 class="fw-bolder mt-2">{{ a.titulo }}</h1>
      <p class="lead text-muted">{{ a.quando.txt }}, às {{ a.quando.hora }}<if test="a.local"> · {{ a.local }}</if></p>
      <if test="a.pauta"><h2 class="h5 fw-bold mt-4">Pauta</h2><div class="corpo">{{ nl2br(a.pauta) }}</div></if>
      <if test="a.ata"><h2 class="h5 fw-bold mt-4">Ata</h2><div class="corpo">{{ markdown(a.ata) }}</div></if>
      <if test="a.arquivo"><p><a class="btn btn-outline-primary" href="{{ a.arquivo.url }}" target="_blank">Baixar a ata assinada</a></p></if>
      <if test="a.futura">
        <div class="card border-0 shadow-sm mt-4"><div class="card-body p-4">
          <h2 class="h5 fw-bolder">Confirmar presença</h2>
          <p class="text-muted small">{{ confirmados }} presença(s) confirmada(s). Use o código que está no link da sua área de sócio.</p>
          <form save="presencas" run="confirmar_presenca" limit="5" success="Presença confirmada. Até lá!">
            <input type="hidden" name="assembleia" value="{{ a.slug }}">
            <div class="input-group"><input class="form-control" name="codigo" required maxlength="20" placeholder="Seu código de sócio" aria-label="Código de sócio"><button class="btn btn-primary" type="submit">Confirmar</button></div>
          </form>
        </div></div>
      </if>
    </div></div></div></section>
  </page>

  <!-- ================= Avisos ================= -->
  <page route="/avisos" title="Avisos">
    <section class="py-5"><div class="container px-4 px-lg-5 my-3"><div class="row justify-content-center"><div class="col-lg-8">
      <h1 class="fw-bolder mb-4">Avisos</h1>
      <each p in="avisos">
        <a class="card border-0 shadow-sm mb-3 text-decoration-none link-dark" href="{{ url('/avisos/' + p.slug) }}"><div class="card-body p-4">
          <span class="badge bg-primary bg-gradient rounded-pill mb-2">{{ p.categoria }}</span>
          <h2 class="h5 fw-bolder">{{ p.titulo }}</h2><p class="text-muted mb-0">{{ p.data.txt }} · {{ p.excerto }}</p>
        </div></a>
      </each>
    </div></div></div></section>
  </page>
  <page route="/avisos/:slug" conteudo="avisos">
    <nep>let p = preparar(item)</nep>
    <section class="py-5"><div class="container px-4 px-lg-5 my-3"><div class="row justify-content-center"><div class="col-lg-8">
      <a class="small text-decoration-none" href="{{ url('/avisos') }}">← Avisos</a>
      <h1 class="fw-bolder mt-2">{{ p.titulo }}</h1>
      <p class="text-muted">{{ p.data.txt }}</p>
      <div class="corpo fs-5">{{ markdown(p.corpo) }}</div>
    </div></div></div></section>
  </page>

  <!-- ================= Transparência ================= -->
  <page route="/transparencia" title="Transparência">
    <nep>
      let meses = []
      let ano = int(date(now(), "Y"))
      let mes = int(date(now(), "m"))
      for i in range(6) do
        let r = ref(ano, mes)
        push(meses, {ref: r, nome: nome_mes(r), total: soma(pagas |> filter(fn(m) do m.referencia == r end))})
        mes = mes - 1
        if mes < 1 do
          mes = 12
          ano = ano - 1
        end
      end
      let maior = 1
      for m in meses do maior = max(maior, m.total) end
      let docs = db.all("documentos")
    </nep>
    <section class="py-5"><div class="container px-4 px-lg-5 my-3">
      <h1 class="fw-bolder">Transparência</h1>
      <p class="lead text-muted" editavel="transparencia.texto">O que a associação arrecada com as mensalidades, mês a mês, e os documentos oficiais.</p>
      <div class="row gx-5 mt-4">
        <div class="col-lg-7 mb-5">
          <div class="card border-0 shadow-sm"><div class="card-body p-4">
            <h2 class="h5 fw-bolder mb-3">Mensalidades recebidas</h2>
            <each m in="meses">
              <div class="mb-3"><div class="d-flex justify-content-between small"><span>{{ m.nome }}</span><b>{{ money(m.total) }}</b></div>
              <div class="barra"><span style="width: {{ round(100 * m.total / maior) }}%"></span></div></div>
            </each>
            <p class="small text-muted mb-0">{{ ativos }} sócio(s) ativo(s).</p>
          </div></div>
        </div>
        <div class="col-lg-5 mb-5">
          <h2 class="h5 fw-bolder mb-3">Documentos</h2>
          <ul class="list-unstyled">
            <each d in="docs"><li class="mb-2">⟦icone "journal-text"⟧ <a href="{{ d.arquivo.url }}" target="_blank">{{ d.titulo }}</a> <span class="text-muted small">· {{ d.tipo }}</span></li>
            <else><li class="text-muted">O estatuto e os balancetes aparecem aqui quando a diretoria publicar no painel.</li></each>
          </ul>
        </div>
      </div>
    </div></section>
  </page>

  <!-- ================= Tesouraria (só diretoria) ================= -->
  <page route="/tesouraria" title="Tesouraria" noindex>
    <nep>
      if not admin do redirect(url("/_admin/login")) end
      let socios = db.all("socios") |> sort_by("nome")
      let informadas = db.where("mensalidades", "status", "Informada")
      let pendentes = db.where("socios", "status", "Pendente")
      for s in socios do gerar_mensalidades(s) end
      let em_aberto = db.where("mensalidades", "status", "Aberta")
    </nep>
    <section class="py-5"><div class="container px-4 px-lg-5">
      <h1 class="fw-bolder">Tesouraria</h1>
      <p class="text-muted">Só quem está logado no painel vê esta página. Para aprovar sócios e editar valores, use o <a href="{{ url('/_admin') }}">painel</a>.</p>
      <if test="request.query.ok"><div class="nep-ok">Pagamento confirmado.</div></if>
      <div class="row g-4 my-2 text-center">
        <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3"><div class="h3 fw-bolder mb-0">{{ ativos }}</div><small class="text-muted">ativos</small></div></div>
        <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3"><div class="h3 fw-bolder mb-0">{{ len(pendentes) }}</div><small class="text-muted">fichas para aprovar</small></div></div>
        <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3"><div class="h3 fw-bolder mb-0">{{ len(informadas) }}</div><small class="text-muted">Pix para conferir</small></div></div>
        <div class="col-6 col-md-3"><div class="bg-light rounded-3 p-3"><div class="h3 fw-bolder mb-0">{{ money(soma(em_aberto)) }}</div><small class="text-muted">em aberto</small></div></div>
      </div>
      <h2 class="h5 fw-bolder mt-4">Pix informados pelos sócios</h2>
      <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Sócio</th><th>Mês</th><th>Valor</th><th></th></tr></thead><tbody>
        <each m in="informadas"><tr><td>{{ m.nome }}</td><td>{{ nome_mes(m.referencia) }}</td><td>{{ money(float(default(m.valor, 0))) }}</td>
          <td class="text-end"><form save="baixas" run="confirmar"><input type="hidden" name="mensalidade" value="{{ m.id }}"><button class="btn btn-sm btn-primary">Confirmar recebimento</button></form></td></tr>
        <else><tr><td colspan="4" class="text-muted">Nenhum por enquanto.</td></tr></each>
      </tbody></table></div>
      <h2 class="h5 fw-bolder mt-4">Sócios</h2>
      <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Nº</th><th>Nome</th><th>Situação</th><th>Em aberto</th><th>Área do sócio</th></tr></thead><tbody>
        <each s in="socios"><tr><td>{{ default(s.numero, s.id) }}</td><td>{{ s.nome }}<div class="small text-muted">{{ default(s.email, '') }}</div></td><td><span class="selo {{ s.status }}">{{ s.status }}</span></td>
          <td>{{ len(em_aberto |> filter(fn(m) do m.socio == s.codigo end)) }}</td><td><a href="{{ url('/socio/' + s.codigo) }}" target="_blank">abrir</a></td></tr>
        <else><tr><td colspan="5" class="text-muted">Nenhum sócio ainda.</td></tr></each>
      </tbody></table></div>
    </div></section>
  </page>

  <page route="/contato" title="Contato">
    <section class="py-5"><div class="container px-4 px-lg-5">
      <div class="bg-light rounded-3 py-5 px-4 px-md-5">
        <div class="text-center mb-5"><h1 class="fw-bolder" editavel="contato.titulo">Fale com a diretoria</h1><p class="lead fw-normal text-muted mb-0" editavel="contato.texto">⟦h .Setor.Chamada⟧</p></div>
        <div class="row gx-5 justify-content-center"><div class="col-lg-8 col-xl-6">⟦template "form-contato" .⟧<ul class="list-unstyled mt-4 text-muted">⟦template "contatos" .⟧</ul></div></div>
      </div>
    </div></section>
  </page>

  <page route="404" title="Não encontrado">
    <section class="py-5"><div class="container px-4 px-lg-5 my-5 text-center">
      <h1 class="display-5 fw-bolder">Página não encontrada</h1>
      <p class="lead text-muted">Volte para o <a href="{{ url('/') }}">início</a>.</p>
    </div></section>
  </page>
</main>

<footer class="bg-dark py-5 mt-auto">
  <div class="container px-4 px-lg-5">
    <div class="row gx-5 text-white-50 small">
      <div class="col-md-5 mb-4"><div class="h5 text-white fw-bolder" editavel="rodape.nome">⟦h .Nome⟧</div><p editavel="rodape.texto">⟦h (maior .Resumo .Setor.Texto)⟧</p></div>
      <div class="col-md-3 mb-4"><div class="text-white fw-bold mb-2">Sócios</div><nav class="d-grid gap-1">
        <a class="text-decoration-none" href="{{ url('/associe-se') }}">Associe-se</a><a class="text-decoration-none" href="{{ url('/entrar') }}">Já sou sócio</a><a class="text-decoration-none" href="{{ url('/transparencia') }}">Transparência</a></nav></div>
      <div class="col-md-4 mb-4"><div class="text-white fw-bold mb-2">Contato</div><ul class="list-unstyled">⟦template "contatos" .⟧</ul></div>
    </div>
    <div class="d-flex flex-wrap justify-content-between gap-2 border-top border-secondary pt-4 small">
      <span class="text-white">© ⟦h .Nome⟧ ⟦.Ano⟧</span>
      <span class="text-white-50"><a href="{{ url('/_admin') }}">Painel</a> · Feito com Nepenthes · tema Modern Business (Start Bootstrap, MIT)</span>
    </div>
  </div>
</footer>
⟦template "scripts" .⟧
</body>
</html>
