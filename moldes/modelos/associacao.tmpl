  <label>Tipo <select name="tipo"><option>Estatuto</option><option>Balancete</option><option>Regimento</option><option>Ata</option><option>Outro</option></select></label>
  <label>Arquivo <input type="file" name="arquivo" required accept="application/pdf,image/*" data-max-mb="10" data-publico></label>
</conteudo>

<nep>
⟦template "nep-comum" .⟧
  let MENSALIDADE = ⟦.Valor⟧
  let CHAVE_PIX = ⟦s .Pix⟧
  let RECEBEDOR = ⟦s .Nome⟧
  let CIDADE_PIX = ⟦s (maior .Cidade "Brasil")⟧

  # Conteúdo de exemplo na primeira vez.
  if db.count("avisos") == 0 do
⟦range .Avisos⟧    db.insert("avisos", {titulo: ⟦s .Titulo⟧, slug: slug(⟦s .Titulo⟧), categoria: ⟦s .Cat⟧, corpo: ⟦s .Corpo⟧, publicar_em: ⟦s .Data⟧, publicado: true})
⟦end⟧  end
  if db.count("assembleias") == 0 do
⟦range .Assembleias⟧    db.insert("assembleias", {titulo: ⟦s .Titulo⟧, slug: slug(⟦s .Titulo⟧), data: ⟦s .Data⟧, local: ⟦s .Local⟧, pauta: ⟦s .Pauta⟧, ata: ⟦s .Ata⟧, publicado: true})
⟦end⟧  end

  # Sócio cadastrado pelo painel sem código: ganha um agora.
  for s in db.all("socios") do
    if not s.codigo or s.codigo == "" do db.update("socios", s.id, {codigo: token(10)}) end
  end

  fn ref(ano, mes) do
    if mes < 10 do return str(ano) + "-0" + str(mes) end
    return str(ano) + "-" + str(mes)
  end
  fn nome_mes(r) do
    let m = match(default(r, ""), "^(%d%d%d%d)%-(%d%d)")
    if not m do return r end
    return capitalize(MESES[int(m[1]) - 1]) + " de " + m[0]
  end

  # Mensalidades: criadas mês a mês, do "desde" até o mês atual (até 24 de uma vez).
  fn gerar_mensalidades(s) do
    if s.status != "Ativo" do return nil end
    let m = match(default(s.desde, ""), "^(%d%d%d%d)%-(%d%d)")
    if not m do return nil end
    let ano = int(m[0])
    let mes = int(m[1])
    let hoje = date(now(), "Y-m")
    let existentes = db.where("mensalidades", "socio", s.codigo) |> pluck("referencia")
    let n = 0
    while ref(ano, mes) <= hoje and n < 24 do
      let r = ref(ano, mes)
      if not contains(existentes, r) do
        db.insert("mensalidades", {socio: s.codigo, nome: s.nome, referencia: r, valor: MENSALIDADE, vencimento: r + "-10", status: "Aberta", publicado: true})
      end
      mes = mes + 1
      if mes > 12 do
        mes = 1
        ano = ano + 1
      end
      n = n + 1
    end
  end

  fn socio_por_codigo(c) do
    if not c or len(c) < 6 do return nil end
    return first(db.where("socios", "codigo", c))
  end
  fn mensalidades_de(s) do
    return db.where("mensalidades", "socio", s.codigo) |> sort_by("referencia") |> reverse
  end
  fn pix_de(m) do
    if CHAVE_PIX == "" do return "" end
    return pix(CHAVE_PIX, RECEBEDOR, CIDADE_PIX, float(default(m.valor, MENSALIDADE)), "M" + str(m.id) + m.socio)
  end

  # Pedido de associação (formulário público)
  fn novo_socio(d) do
    d.email = lower(trim(d.email))
    if len(db.where("socios", "email", d.email)) > 0 do
      recusar("Esse e-mail já está cadastrado. Use “Já sou sócio” para receber o link da sua área.")
    end
    d.codigo = token(10)
    d.numero = str(1000 + db.count("socios") + 1)
    d.status = "Pendente"
    d.desde = date(now(), "Y-m-d")
    return "/socio/" + d.codigo + "?novo=1"
  end

  # "Já paguei": o sócio avisa; a tesouraria confere e dá baixa.
  fn informar(d) do
    let s = socio_por_codigo(d.codigo)
    let m = db.find("mensalidades", int(default(d.mensalidade, "0")))
    if not s or not m or m.socio != s.codigo do recusar("Mensalidade não encontrada.") end
    if m.status == "Aberta" do db.update("mensalidades", m.id, {status: "Informada"}) end
    return "/socio/" + s.codigo + "?informado=1"
  end

  # Tesouraria: confirmar pagamento (só quem está logado no painel)
  fn confirmar(d) do
    if not admin do recusar("Só a diretoria pode confirmar pagamentos.") end
    let m = db.find("mensalidades", int(default(d.mensalidade, "0")))
    if not m do recusar("Mensalidade não encontrada.") end
    db.update("mensalidades", m.id, {status: "Paga", pago_em: date(now(), "Y-m-d")})
    return "/tesouraria?ok=1"
  end

  # Esqueceu o link: manda por e-mail (sem dizer se o e-mail existe)
  fn enviar_link(d) do
    let s = first(db.where("socios", "email", lower(trim(default(d.email, "")))))
    if s and s.codigo do
      enviar_email(s.email, "Sua área de sócio · " + RECEBEDOR,
        "Olá, " + s.nome + "!\n\nEste é o link da sua área de sócio, com a carteirinha e as mensalidades:\n" +
        default(request.site, "") + "/socio/" + s.codigo + "\n\nGuarde este link: ele é só seu.")
    end
  end

  fn confirmar_presenca(d) do
    let s = socio_por_codigo(trim(default(d.codigo, "")))
    if not s do recusar("Código de sócio não encontrado. Ele está no link da sua área: /socio/CÓDIGO") end
    if len(db.where("presencas", "chave", d.assembleia + ":" + s.codigo)) > 0 do recusar("Sua presença já estava confirmada.") end
    d.chave = d.assembleia + ":" + s.codigo
    d.nome = s.nome
  end

  let agora = date(now(), "Y-m-d H:i")
  fn preparar_assembleia(a) do
    a.quando = ler_data(a.data)
    a.futura = a.quando.chave >= agora
    return a
  end
  let assembleias = db.all("assembleias") |> map(preparar_assembleia) |> sort_by(fn(a) do a.quando.chave end)
  let proximas = assembleias |> filter(fn(a) do a.futura end)
  let anteriores = assembleias |> filter(fn(a) do not a.futura end) |> reverse
  let avisos = db.all("avisos") |> map(preparar) |> sort_by(fn(p) do p.data.chave end) |> reverse
  let ativos = len(db.where("socios", "status", "Ativo"))
  let pagas = db.where("mensalidades", "status", "Paga")
  let mes_atual = date(now(), "Y-m")
  fn soma(l) do
    let t = 0
    for x in l do t = t + float(default(x.valor, 0)) end
    return t
  end
  fn ativo(r) do
    if r == "/" do return (request.path == "/" and " active") or "" end
    return (starts_with(request.path, r) and " active") or ""
  end
</nep>

