⟦/* código comum: datas, resumo, leitura, newsletter, contato */⟧
⟦define "nep-comum"⟧
  let MESES = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"]
  let MES3 = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"]

  # "2026-10-21T10:30" (painel) ou "2026-10-21 10:30:00" (banco)
  fn ler_data(s) do
    let m = match(default(s, ""), "^(%d%d%d%d)%-(%d%d)%-(%d%d)[T ](%d%d):(%d%d)")
    if not m do return {ano: "", mm: "", dia: "", mes: "", m3: "", txt: "", chave: "", hora: ""} end
    let mes = MESES[int(m[1]) - 1]
    return {ano: m[0], mm: m[1], dia: str(int(m[2])), mes: mes, m3: MES3[int(m[1]) - 1], hora: m[3] + ":" + m[4],
            chave: m[0] + "-" + m[1] + "-" + m[2] + " " + m[3] + ":" + m[4],
            txt: str(int(m[2])) + " de " + mes + " de " + m[0]}
  end

  fn minutos_de_leitura(texto) do
    let n = 0
    for w in gmatch(default(texto, ""), "%S+") do n = n + 1 end
    return max(1, round(n / 200))
  end

  fn resumo_de(p) do
    if p.resumo do return p.resumo end
    let t = gsub(default(p.corpo, ""), "%[([^%]]*)%]%b()", "%1")
    t = gsub(t, "\n%s*[-*]%s+", "\n")
    t = gsub(t, "[#*_`>%[%]]", "")
    t = gsub(t, "%s+", " ")
    return truncate(trim(t), 170)
  end

  # Imagem de capa: a enviada no painel ou uma das fotos do molde.
  let CAPAS = ["mesa.jpg", "mapa.jpg", "notebook.jpg", "objetos.jpg", "telefone.jpg", "codigo.jpg", "mar.jpg", "luz.jpg"]
  fn capa_de(p) do
    if p.capa and p.capa.url do return p.capa.url end
    return url("/_nep/molde/img/" + CAPAS[default(p.id, 0) % len(CAPAS)])
  end

  fn preparar(p) do
    p.data = ler_data(default(p.publicar_em, p.created_at))
    p.tags_l = split(default(p.tags, ""), ",") |> map(trim) |> filter(fn(t) do t != "" end)
    p.leitura = minutos_de_leitura(p.corpo)
    p.excerto = resumo_de(p)
    p.autor = default(p.autor, ⟦s (printf "Equipe %s" .Nome)⟧)
    p.img = capa_de(p)
    return p
  end

  fn assinar(d) do
    d.email = lower(trim(d.email))
    if len(db.where("assinantes", "email", d.email)) > 0 do recusar("Esse e-mail já está na lista.") end
  end

  let por_pagina = 5
  let pagina_atual = 1
  if match(default(request.query.pagina, ""), "^%d+$") do pagina_atual = max(1, int(request.query.pagina)) end
⟦end⟧

