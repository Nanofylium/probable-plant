  <div class="form-floating mb-3">
    <textarea class="form-control" id="c-msg" name="mensagem" placeholder="Escreva aqui" style="height: 10rem" required maxlength="4000"></textarea>
    <label for="c-msg">Mensagem</label>
  </div>
  <button class="btn btn-primary btn-lg" type="submit">Enviar</button>
</form>
⟦end⟧

