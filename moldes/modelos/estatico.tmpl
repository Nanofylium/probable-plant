<nep-config nome="⟦h .Nome⟧" lang="pt-BR"
  lowii="Você atende o site de ⟦h .Nome⟧⟦if .Cidade⟧, em ⟦h .Cidade⟧⟦end⟧. Responda com base nos textos do site e convide para entrar em contato.">

<nep>
⟦template "nep-comum" .⟧
</nep>

<html lang="pt-BR">
<head>
⟦template "cabeca" .⟧
  <style>
    body { font-family: "Nunito", system-ui, sans-serif; }
    header.masthead { padding-top: 8rem; padding-bottom: 8rem; }
    header.masthead:before { opacity: .55 !important; }
    header.masthead h1 { font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 800; }
    .features-icons .features-icons-item .features-icons-icon { height: 5rem; font-size: 3.5rem; }
    .showcase .showcase-img { min-height: 22rem; background-size: cover; background-position: center; }
    .call-to-action { background: linear-gradient(135deg, color-mix(in srgb, ⟦.Cor⟧ 80%, #000), ⟦.Cor⟧) !important; }
    .call-to-action:before { display: none; }
    .call-to-action .form-control, .call-to-action .form-floating > label { color: #212529; }
    .call-to-action .nep-ok { color: #135c2f; }
    .call-to-action .btn-primary { --bs-btn-bg: #fff; --bs-btn-color: ⟦.Cor⟧; --bs-btn-border-color: #fff; --bs-btn-hover-bg: #f1f3f5; --bs-btn-hover-color: ⟦.Cor⟧; --bs-btn-hover-border-color: #f1f3f5; }
    .contatos-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1.5rem; padding: 0; margin: 2rem 0 0; list-style: none; }
    .contatos-cta a { color: #fff; }
    footer.footer a { text-decoration: none; }
    .footer .ico, .footer .fs-3 svg { color: var(--nep-cor); }
  </style>
</head>
<body>
