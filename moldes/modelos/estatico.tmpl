    <section class="py-5 text-center"><div class="container py-5">
      <h1 class="fw-bold">Página não encontrada</h1>
      <p class="lead">Volte para o <a href="{{ url('/') }}">início</a>.</p>
    </div></section>
  </page>

  <footer class="footer bg-light">
    <div class="container">
      <div class="row">
        <div class="col-lg-6 h-100 text-center text-lg-start my-auto">
          <ul class="list-inline mb-2">
            <li class="list-inline-item"><a href="#servicos">⟦h .Setor.ServRotulo⟧</a></li>
            <li class="list-inline-item">⋅</li>
