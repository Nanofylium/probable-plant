                    <p>{{ primeiro.excerto }}</p>
                    <div class="small text-muted">{{ primeiro.autor }} · {{ primeiro.data.txt }}</div>
                  </div>
                </div>
              </div>
            </if>
            <div class="row gx-4">
              <each p in="itens">
                <div class="col-md-6 mb-4">
                  <div class="card h-100 shadow-sm border-0 lista-noticia">
