                <li class="page-item{{ (pagina_atual <= 1 and ' disabled') or '' }}"><a class="page-link" href="?pagina={{ pagina_atual - 1 }}{{ (request.query.q and '&q=' + urlencode(request.query.q)) or '' }}">Mais novas</a></li>
                <li class="page-item active"><span class="page-link">{{ pagina_atual }} de {{ paginas }}</span></li>
                <li class="page-item{{ (pagina_atual >= paginas and ' disabled') or '' }}"><a class="page-link" href="?pagina={{ pagina_atual + 1 }}{{ (request.query.q and '&q=' + urlencode(request.query.q)) or '' }}">Mais antigas</a></li>
