  <!-- ================= Listas de notícias ================= -->
  <page route="/noticias" title="Notícias" description="Todas as notícias de ⟦h .Nome⟧.">
    <nep>lista = {titulo: "Notícias", texto: "Tudo o que publicamos, do mais novo para o mais antigo.", itens: noticias}</nep>
  </page>
  <page route="/noticias/editoria/:cat" title="Editoria">
    <nep>
      let nome = find(keys(por_categoria), fn(c) do slug(c) == params.cat end)
      let itens = []
      if nome do
        itens = por_categoria[nome]
      else
        nome = capitalize(gsub(params.cat, "%-", " "))
      end
      page.title = nome
      lista = {titulo: nome, texto: "Notícias da editoria " + nome + ".", itens: itens}
    </nep>
  </page>
  <page route="/busca" title="Busca" noindex>
    <nep>
      let q = trim(default(request.query.q, ""))
      let achados = []
      if q != "" do achados = buscar(q, "noticias") |> map(fn(r) do preparar(r.item) end) end
      lista = {titulo: (q == "" and "Buscar") or "Resultados para “" + q + "”", texto: (q == "" and "Digite uma palavra na caixa de busca.") or str(len(achados)) + " encontrados", itens: achados}
    </nep>
  </page>

  <if test="lista">
    <nep>
      let total = len(lista.itens)
      let paginas = max(1, ceil(total / por_pagina))
      let itens = lista.itens |> skip((pagina_atual - 1) * por_pagina) |> take(por_pagina)
      let primeiro = nil
      if pagina_atual == 1 and len(itens) > 0 do
        primeiro = itens[0]
        itens = itens |> skip(1)
      end
    </nep>
