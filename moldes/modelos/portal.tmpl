                </each>
              </div>
            </if>
            {{ comentarios() }}
          </div>
          <div class="col-lg-4">⟦template "portal-lateral" .⟧</div>
        </div>
      </div>
    </section>
  </page>

  <!-- ================= Agenda ================= -->
  <page route="/agenda" title="Agenda" description="Eventos e programação⟦if .Cidade⟧ em ⟦h .Cidade⟧⟦end⟧.">
    <section class="py-5">
      <div class="container px-5 my-3">
        <div class="text-center mb-5">
