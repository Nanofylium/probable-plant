⟦template "aviso" .⟧
<nep-config nome="⟦h .Nome⟧" lang="pt-BR"
  lowii="Você atende o portal ⟦h .Nome⟧⟦if .Cidade⟧, de ⟦h .Cidade⟧⟦end⟧. Responda com base nas notícias, na agenda e nas páginas do site.">

<!-- ================= o que se edita no painel ================= -->
<conteudo nome="noticias" titulo="Notícias" item="notícia">
  <label>Título <input name="titulo" required maxlength="160"></label>
  <label>Editoria
    <select name="categoria" required>
      <option value="">Escolha…</option>⟦range cats .⟧<option>⟦h .⟧</option>⟦end⟧
    </select>
  </label>
  <label>Linha fina (resumo que aparece nas listas) <textarea name="resumo" maxlength="300" rows="2"></textarea></label>
  <label>Texto <textarea name="corpo" data-editor required maxlength="80000"></textarea></label>
  <label>Foto de capa <input type="file" name="capa" accept="image/*" data-max-mb="6" data-publico></label>
  <label>Tags (separe por vírgula) <input name="tags" maxlength="200"></label>
  <label>Autor <input name="autor" maxlength="60"></label>
  <label>Destaque da capa <input type="checkbox" name="fixado"></label>
</conteudo>

<conteudo nome="eventos" titulo="Agenda" item="evento">
  <label>Título <input name="titulo" required maxlength="140"></label>
  <label>Data e hora <input type="datetime-local" name="data" required></label>
  <label>Local <input name="local" maxlength="120"></label>
  <label>Resumo <textarea name="resumo" maxlength="600" rows="3"></textarea></label>
  <label>Vagas (0 = sem inscrição) <input type="number" name="vagas" min="0" max="100000" value="0"></label>
</conteudo>

<conteudo nome="paginas" titulo="Páginas" item="página">
  <label>Título <input name="titulo" required maxlength="100"></label>
  <label>Texto <textarea name="corpo" data-editor maxlength="60000"></textarea></label>
  <label>Posição no menu (0 = fora do menu) <input type="number" name="ordem" min="0" max="99" value="10"></label>
</conteudo>

<nep>
⟦template "nep-comum" .⟧
  # Conteúdo de exemplo na primeira vez (depois, tudo pelo painel).
  if db.count("noticias") == 0 do
⟦range .Posts⟧    db.insert("noticias", {titulo: ⟦s .Titulo⟧, slug: slug(⟦s .Titulo⟧), categoria: ⟦s .Cat⟧, resumo: ⟦s .Resumo⟧, tags: ⟦s .Tags⟧, autor: ⟦s .Autor⟧, publicar_em: ⟦s .Data⟧, fixado: ⟦.Fixado⟧, publicado: true, corpo: ⟦s .Corpo⟧})
⟦end⟧  end
  if db.count("eventos") == 0 do
⟦range .Eventos⟧    db.insert("eventos", {titulo: ⟦s .Titulo⟧, slug: slug(⟦s .Titulo⟧), data: ⟦s .Data⟧, local: ⟦s .Local⟧, resumo: ⟦s .Resumo⟧, vagas: ⟦.Vagas⟧, publicado: true})
⟦end⟧  end

  let noticias = db.all("noticias") |> map(preparar) |> sort_by(fn(p) do p.data.chave end) |> reverse
  let destaque = first(noticias |> filter(fn(p) do p.fixado end)) or first(noticias)
  let por_categoria = noticias |> group_by("categoria")
  let agora = date(now(), "Y-m-d H:i")
  fn preparar_evento(e) do
    e.quando = ler_data(e.data)
    return e
  end
  let eventos = db.all("eventos") |> map(preparar_evento) |> filter(fn(e) do e.quando.chave >= agora end) |> sort_by(fn(e) do e.quando.chave end)
  let paginas_menu = db.all("paginas") |> filter(fn(p) do default(p.ordem, 0) > 0 end) |> sort_by("ordem")

  fn link_noticia(p) do return url("/noticias/" + p.slug) end
  fn link_cat(c) do return url("/noticias/editoria/" + slug(c)) end
  fn ativo(r) do
    if r == "/" do return (request.path == "/" and " active") or "" end
    return (starts_with(request.path, r) and " active") or ""
  end

  fn inscrever(d) do
    let e = first(db.where("eventos", "slug", d.evento))
    if not e do recusar("Evento não encontrado.") end
    if default(e.vagas, 0) > 0 and len(db.where("inscricoes", "evento", d.evento)) >= int(e.vagas) do recusar("As vagas deste evento acabaram.") end
  end

  # o que as listas de notícias preenchem (a lista é desenhada uma vez, no layout)
  let lista = nil
</nep>

<api route="/api/noticias">
  return noticias |> map(fn(p) do {titulo: p.titulo, editoria: p.categoria, data: p.data.chave, url: link_noticia(p)} end)
</api>

