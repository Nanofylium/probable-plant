# Nepenthes em hospedagem compartilhada (Apache + CGI, como cPanel).
# Envie para a pasta do site: este .htaccess, o executável renomeado para nep.cgi
# (versão linux-amd64, com permissão 755) e o seu site.nep.html.
Options -Indexes +ExecCGI
AddHandler cgi-script .cgi
DirectoryIndex nep.cgi

<IfModule mod_rewrite.c>
  RewriteEngine On
  # arquivos internos nunca são entregues
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^data(/|$) - [F,L]
  RewriteRule \.(nep\.html|nep|db|lock|log)$ - [F,L]
  # o que não é arquivo de verdade (páginas, /_admin, /_nep/...) vai para o Nepenthes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ nep.cgi [L,QSA]
</IfModule>

<FilesMatch "(\.nep\.html|\.nep|\.db|\.lock|\.log|SETUP_TOKEN\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
